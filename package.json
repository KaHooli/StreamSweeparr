{
  "name": "streamsweeparr",
  "version": "1.0.0",
  "private": true,
  "description": "Seerr-style tool that unmonitors/deletes Sonarr & Radarr media available on your chosen streaming services (via Watchmode), re-monitors media that has left streaming, and triggers searches.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "next": "14.2.35",
    "pg": "^8.12.0",
    "pg-copy-streams": "^6.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "14.2.35",
    "prisma": "^5.18.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
