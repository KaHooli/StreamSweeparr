{
  "name": "streamsweeparr",
  "version": "1.0.0",
  "private": true,
  "description": "Seerr-style tool that unmonitors/deletes Sonarr & Radarr media available on your chosen streaming services (via Watchmode), re-monitors media that has left streaming, and triggers searches.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "next": "14.2.5",
    "pg": "^8.12.0",
    "pg-copy-streams": "^6.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "prisma": "^5.18.0",
    "typescript": "^5.5.3"
  }
}
