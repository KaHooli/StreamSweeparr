{
  "name": "streamsweeparr",
  "version": "1.0.0",
  "private": true,
  "description": "Seerr-style tool that unmonitors/deletes Sonarr & Radarr media available on your chosen streaming services (via Watchmode), re-monitors media that has left streaming, and triggers searches.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "next": "16.2.12",
    "pg": "^8.12.0",
    "pg-copy-streams": "^6.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prisma": "^5.18.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
