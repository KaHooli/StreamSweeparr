{
  "name": "streamsweeparr",
  "version": "1.0.0",
  "private": true,
  "description": "Seerr-style tool that unmonitors/deletes Sonarr & Radarr media available on your chosen streaming services (via Watchmode), re-monitors media that has left streaming, and triggers searches.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "check:node": "node scripts/check-node-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "pg-copy-streams": "^6.0.6",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  }
}
