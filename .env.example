# PostgreSQL connection string (external server).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://streamsweeparr:streamsweeparr@localhost:5432/streamsweeparr?schema=public"

# Secret used to sign login session cookies (HMAC). REQUIRED in production so
# sessions survive restarts and cannot be forged. Use a long random string,
# e.g.  openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: disable the background Title ID map refresh timer on this instance.
# TITLE_MAP_SCHEDULER=off

# Optional: port for `next start` (defaults to 3000)
# PORT=3000
