# PostgreSQL connection string (external server).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://streamsweeparr:streamsweeparr@localhost:5432/streamsweeparr?schema=public"

# Tip for small/low-CPU hosts (e.g. Unraid, NAS, 1-2 vCPU VMs):
# Prisma sizes its connection pool from the CPU count ((cpus * 2) + 1), so a
# 1-CPU container gets a pool of 3. Pages that issue several requests at once
# can then exhaust the pool and time out. Raise it explicitly by appending:
#   ...?schema=public&connection_limit=10&pool_timeout=20

# Secret used to sign login session cookies (HMAC) AND to derive the key that
# encrypts stored credentials (API keys, the OIDC client secret) at rest.
# REQUIRED in production — the app REFUSES to start without a value of >= 16
# chars. Generate one with:  openssl rand -hex 32
#
# WARNING: changing this after setup makes saved API keys unreadable. They are
# encrypted with AES-256-GCM, which detects the wrong key rather than decrypting
# to garbage, so affected keys read as "not configured" and must be re-entered
# in Settings (or the previous value restored). Nothing destructive happens in
# the meantime — a sync refuses to run without an API key.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Local (username & password) admin account ---
# Optional. The single username/password account is always an administrator.
# If set, these are used to create the account on first run AND remain
# authoritative afterwards — so the credentials in your compose file always work
# and give you a way back in if you forget the password. Unset them to manage
# the username/password entirely in the UI.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="a-strong-password"

# Hide the username/password form on the login page (single sign-on only).
# Only possible while OIDC is enabled AND fully configured; otherwise the form
# is always shown so you can't lock yourself out.
#   true  -> hide the password form
#   false -> force the password form on (escape hatch if OIDC breaks)
# Leave unset to control this from Settings -> Users & security -> Login options.
# LOCAL_LOGIN_DISABLED=true

# Serve auth cookies WITHOUT the Secure flag. Required when the app is accessed
# over plain HTTP (e.g. http://host:3000), because browsers silently drop
# Secure cookies over HTTP — which makes login "not work" (you sign in but never
# reach the dashboard). Leave unset/false when behind HTTPS (recommended).
# AUTH_COOKIE_INSECURE=true

# Public URL of the app as users/OIDC providers reach it, e.g.
# https://streamsweeparr.example.com — REQUIRED behind a reverse proxy so the
# OIDC redirect_uri matches what you register with your provider. Without it the
# app guesses from proxy headers (only when TRUST_PROXY=true), then the Host
# header. Setting it explicitly is also the only way to be sure a spoofed Host
# header can never appear in a redirect the app issues.
# It is also the base for the Open Graph / Twitter image URLs in the page
# metadata, which have to be absolute and cannot be guessed per request; left
# unset they point at http://localhost:3000, which only matters if you share a
# link to this instance somewhere that renders a preview.
# PUBLIC_URL="https://streamsweeparr.example.com"

# Trust X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
# Set this to "true" ONLY when a reverse proxy you control sits in front of the
# app and overwrites those headers. If the app is reachable directly, any client
# can forge them — which would let an attacker pick their own login rate-limit
# bucket and never get locked out. Left off, the per-username and instance-wide
# login limiters still apply, but per-IP throttling is effectively disabled.
# TRUST_PROXY=true

# Optional: override the OIDC callback URL outright (rarely needed; PUBLIC_URL
# is usually enough). Must exactly equal the URI registered with your provider.
# OIDC_REDIRECT_URI="https://streamsweeparr.example.com/api/auth/oidc/callback"

# SSRF guard: user-supplied Sonarr/Radarr/Seerr/OIDC URLs are DNS-resolved and
# requests to loopback/link-local/cloud-metadata are ALWAYS blocked. Private
# LAN ranges (10/8, 172.16/12, 192.168/16) are blocked unless you opt in here.
# Set to "true" if your *arr apps live on a private network.
# SSRF_ALLOW_PRIVATE=true

# How many titles a sync looks up in parallel (default 4, max 32). Sync is
# almost entirely waiting on TMDB/Watchmode/Sonarr, so raising this shortens a
# large library's sync considerably. Each in-flight title also holds a database
# connection while it writes, and Prisma's pool defaults to (cpus * 2) + 1 —
# so if you raise this, raise `connection_limit` in DATABASE_URL to match.
# SYNC_CONCURRENCY=4

# Log verbosity for background work: debug | info | warn | error (default info).
# LOG_LEVEL=info

# Optional: disable the background Title ID map refresh timer on this instance.
# TITLE_MAP_SCHEDULER=off

# Optional: stop this instance from running scheduled sweeps (Settings -> Run
# options -> Scheduled sweeps). The schedule stays configured; this instance
# simply never fires it. Slots are claimed atomically in the database, so
# running several replicas without this is safe — only one fires each sweep.
# SWEEP_SCHEDULER=off
#
# This also covers webhook-triggered sweeps (Settings -> Run options -> Sweep
# new titles as they're added): an instance opted out still ACCEPTS webhooks and
# queues the titles, it just never turns them into runs. At least one instance
# must be left without this, or the queue only grows.

# Optional: how long a webhook-queued title waits before its sweep starts
# (default 60 seconds, capped at 3600). Sonarr fires "On Series Add" the instant
# a show is added — before it has fetched the episode list — so the delay is
# what makes sure there is something to sweep. It also coalesces a batch of
# additions into a single run. Raise it if your Sonarr is slow to refresh.
# WEBHOOK_SWEEP_DELAY_SECONDS=60

# Optional: port for `next start` (defaults to 3000)
# PORT=3000
