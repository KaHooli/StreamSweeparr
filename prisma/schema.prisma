// StreamSweeparr database schema (PostgreSQL)
//
// The database is used for two things:
//   1. Persisting user configuration (API keys, selected countries/services,
//      Sonarr/Radarr connections, options).
//   2. Caching the last-known state of media & streaming availability so the
//      dashboard renders instantly and runs can be audited.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Where movie streaming availability comes from. TV has no equivalent choice:
// Watchmode is the only provider here with per-episode data.
enum MovieProvider {
  TMDB
  WATCHMODE
}

// Single-row application settings (id is always 1).
model Settings {
  id                Int      @id @default(1)
  // Watchmode API keys, in the order they are used. Requests always start at
  // the first key and move to the next one when a key is rejected or has run
  // out of quota, so several free-tier keys can be pooled into one budget.
  // Each element is encrypted individually (see lib/secrets.ts).
  watchmodeApiKeys  String[] @default([])
  // The first key, mirrored for older code paths and for the boot-time
  // plaintext-to-ciphertext migration. `watchmodeApiKeys` is the source of
  // truth; getSettings() derives this from it.
  watchmodeApiKey   String?
  // Seerr (optional) — used to auto-discover Sonarr/Radarr instances.
  seerrUrl          String?
  seerrApiKey       String?
  // Selected Watchmode region codes, e.g. ["US","GB"].
  countries         String[] @default([])
  // Selected Watchmode source ids the user considers "their" streaming services.
  serviceIds        Int[]    @default([])
  // Which source types count as "available on streaming".
  // Watchmode types: sub, free, purchase, rent, tv_everywhere.
  countedTypes      String[] @default(["sub", "free"])

  // Which provider answers "is this movie on streaming?". TV is always
  // Watchmode (nothing else has per-episode data), but movies have a choice,
  // and the default is deliberately TMDB: its API is free and unmetered, so
  // every movie looked up there is a Watchmode credit left for TV.
  // WATCHMODE is for the user who would rather configure one provider than two
  // and has credits to spare — it reads the same countries/services/counted
  // types as TV, and answers from the title-level sources endpoint.
  movieProvider     MovieProvider @default(TMDB)

  // --- TheMovieDB (TMDB) — the default source of MOVIE availability ---
  // TV episodes always use Watchmode (per-episode data); movies use TMDB's
  // JustWatch-powered watch/providers data unless `movieProvider` says
  // otherwise, in which case these columns are simply unused.
  tmdbApiKey        String?
  // Selected TMDB watch-provider region codes (ISO 3166-1), e.g. ["US","GB"].
  tmdbRegions       String[] @default([])
  // Selected TMDB movie provider ids the user subscribes to.
  tmdbProviderIds   Int[]    @default([])
  // Which TMDB provider categories count as "available on streaming".
  // TMDB categories: flatrate, free, ads, rent, buy.
  tmdbCountedTypes  String[] @default(["flatrate", "free"])
  // Automatically delete files when unmonitoring (destructive).
  deleteFiles       Boolean  @default(true)
  // Delete files for EVERY item left unmonitored after a sweep, not just the
  // titles that sweep itself unmonitored. Clears a pre-existing unmonitored
  // back-catalogue. Off by default because it is broad and destructive.
  purgeUnmonitoredFiles Boolean @default(false)
  // Trigger a search for all monitored items at the end of a run.
  searchAtEnd       Boolean  @default(true)
  // Remove movies from Radarr when TMDB reports their id no longer exists.
  removeMissingTmdbMovies Boolean @default(true)
  // Perform destructive changes. When false the run is a dry-run (preview only).
  applyChanges      Boolean  @default(false)

  // --- Scheduled sweeps ---
  // Run a sweep automatically every `sweepIntervalHours` hours. Scheduled runs
  // honour applyChanges exactly like a manual sweep, so leaving LIVE mode off
  // makes the schedule a recurring dry-run.
  sweepScheduleEnabled Boolean @default(false)
  sweepIntervalHours   Int     @default(12)
  // When the next scheduled sweep is due. Persisted (rather than kept in the
  // process) so restarts don't reset the countdown and replicas agree on the
  // slot — claiming a slot is an atomic update of this column.
  sweepNextRunAt       DateTime?
  // Last time the scheduler claimed a slot and started a sweep.
  sweepLastRunAt       DateTime?

  // --- Webhook-triggered sweeps ---
  // Sonarr and Radarr call StreamSweeparr when a series/movie is added, and
  // only that one title is swept. Off by default: it opens an endpoint that is
  // reachable without a session, so it has to be an explicit choice.
  webhookEnabled       Boolean @default(false)
  // Shared secret every webhook call must present (query string, header, bearer
  // or basic-auth password). Encrypted at rest like every other credential;
  // generated for the user when webhooks are switched on.
  webhookToken         String?

  // --- Watchmode Title ID map dataset sync metadata ---
  // HTTP validators from the last successful title_id_map.csv download, used to
  // skip re-importing when the dataset has not changed.
  titleMapEtag         String?
  titleMapLastModified String?
  titleMapSyncedAt     DateTime?
  titleMapRowCount     Int      @default(0)

  // --- Watchmode changes-feed cursor ---
  // Timestamp of the last successful sync that consulted the Watchmode
  // /changes/titles_episodes_changed feed. On the next sync we ask "what changed
  // since then" so we only re-pull episodes for series that actually changed.
  // Null = never (first run pulls everything). Set to null to force a full pull.
  watchmodeChangesCursor DateTime?

  // --- Watchmode plan detection ---
  // Whether the Watchmode account can use the premium Changes API.
  // "paid" -> change-detection enabled; "free"/"unknown" -> the TTL below is
  // the only thing rationing credits.
  // Auto-detected by probing the changes endpoint; re-checked periodically.
  watchmodePlan          String?   // "paid" | "free" | "unknown" | null (unchecked)
  watchmodePlanCheckedAt DateTime?

  // How many days a Watchmode answer is kept before that title is looked up
  // again — episodes, provider deep links, and movies when `movieProvider` is
  // WATCHMODE. The default of 7 is what a free / developer key's monthly credit
  // budget is sized for; a paid key already has change detection and can afford
  // a shorter window. Bounds and clamping live in lib/watchmodeCache.ts.
  watchmodeCacheDays     Int      @default(7)

  // Whether the username/password form is offered on the login page. This can
  // only be turned off while OIDC is enabled and configured (otherwise there
  // would be no way to sign in) — see effectiveLocalLoginEnabled().
  localLoginEnabled Boolean  @default(true)

  // --- OIDC single sign-on (optional) ---
  // When issuer + clientId + clientSecret are set, an "Sign in with SSO" button
  // appears on the login page.
  oidcEnabled       Boolean  @default(false)
  // Label for the SSO button on the login page, e.g. "Sign in with Authentik".
  // Null/empty falls back to DEFAULT_SSO_BUTTON_LABEL.
  oidcButtonLabel   String?
  oidcIssuer        String?  // e.g. https://auth.example.com  (issuer or discovery base)
  oidcClientId      String?
  oidcClientSecret  String?
  // Space-separated scopes; defaults to "openid profile email".
  oidcScopes        String   @default("openid profile email")
  // Optional explicit endpoint overrides (otherwise discovered from issuer).
  oidcAuthUrl       String?
  oidcTokenUrl      String?
  oidcUserinfoUrl   String?
  // If set, only users whose email/preferred_username is in this list may sign
  // in via OIDC. Empty = allow any authenticated OIDC user.
  oidcAllowedUsers  String[] @default([])

  updatedAt         DateTime @updatedAt

  connections ArrConnection[]
}

// Application user. Local users authenticate with username + password hash;
// OIDC users are provisioned on first successful SSO login (passwordHash null).
enum Role {
  ADMIN
  USER
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  // scrypt hash in the form "scrypt$<saltHex>$<hashHex>"; null for pure OIDC.
  passwordHash  String?
  // OIDC subject / issuer this user maps to (null for local users).
  oidcSubject   String?  @unique
  // The local username/password account is always ADMIN. Users provisioned via
  // OIDC start as USER and can be promoted by an admin.
  role          Role     @default(USER)
  // Set for the seeded default admin until the password is changed.
  mustChangePassword Boolean @default(false)
  // Bumped whenever a session must stop being honoured: a role change, a
  // password change, or an admin revoking the account's sessions. Session
  // tokens embed the version they were minted with, and requireSession()
  // rejects any token whose version is behind. Without this a stateless token
  // keeps its baked-in role for the rest of its 7-day life.
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Watchmode Title ID map (imported from
// https://api.watchmode.com/datasets/title_id_map.csv).
// Lets us convert TMDB/IMDB ids -> Watchmode id locally, without spending
// Watchmode search-endpoint quota. Refreshed at most every 12 hours.
//
// CSV columns: Watchmode ID, IMDB ID, TMDB ID, TMDB Type, Title, Year
model TitleIdMap {
  watchmodeId Int     @id
  imdbId      String?
  tmdbId      Int?
  tmdbType    String? // "movie" | "tv"
  title       String?
  year        Int?

  @@index([tmdbId, tmdbType])
  @@index([imdbId])
}

enum ArrType {
  SONARR
  RADARR
}

// A Sonarr or Radarr instance. Can be added manually or synced from Seerr.
model ArrConnection {
  id         Int      @id @default(autoincrement())
  type       ArrType
  name       String
  baseUrl    String
  apiKey     String
  enabled    Boolean  @default(true)
  // "seerr" if discovered from Seerr, "manual" if entered by hand.
  origin     String   @default("manual")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings   Settings @relation(fields: [settingsId], references: [id])
  settingsId Int      @default(1)

  media      MediaItem[]
  queued     QueuedSweep[]

  @@unique([type, baseUrl])
}

// A title waiting for its own targeted sweep, put here by a Sonarr/Radarr
// webhook.
//
// The webhook cannot simply start a sweep: only one run may be active at a
// time, so adding ten shows at once would start one sweep and reject nine.
// Queueing instead means the endpoint always answers immediately, duplicates
// collapse (the unique key is the title itself), and a worker drains the queue
// into one targeted sweep covering everything that has settled.
//
// The queue lives in the database rather than in the process so a restart
// mid-flight doesn't drop the titles, and so several replicas can share it —
// `claimedBy` is what makes a claim exclusive.
model QueuedSweep {
  id           Int       @id @default(autoincrement())
  mediaType    MediaType
  // Primary key from the *arr instance (Sonarr series id / Radarr movie id).
  arrId        Int
  // Title as the webhook reported it, for the run log — the sweep re-reads
  // everything else from the instance.
  title        String
  // The *arr event that queued this, e.g. "SeriesAdd" / "MovieAdded".
  eventType    String?
  queuedAt     DateTime  @default(now())
  // Set while a drain has this row in flight; cleared if the sweep couldn't
  // start, and reaped if the claiming process died.
  claimedAt    DateTime?
  claimedBy    String?
  // Failed drains so far. A title that keeps failing is eventually dropped
  // rather than retried forever.
  attempts     Int       @default(0)

  connection   ArrConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId Int

  // One pending entry per title: a webhook fired twice queues one sweep.
  @@unique([connectionId, mediaType, arrId])
  // The drain asks for unclaimed rows, oldest first.
  @@index([claimedAt, queuedAt])
}

enum MediaType {
  MOVIE
  TV
}

// Cached snapshot of a movie or series across the *arr instances, enriched
// with Watchmode streaming availability. Refreshed on each sync.
model MediaItem {
  id             Int       @id @default(autoincrement())
  type           MediaType
  // Primary key from the *arr instance.
  arrId          Int
  title          String
  year           Int?
  posterUrl      String?
  tmdbId         Int?
  imdbId         String?
  tvdbId         Int?
  watchmodeId    Int?

  monitored      Boolean   @default(false)
  hasFile        Boolean   @default(false)
  // Radarr's file id for a movie that has one (movies only; episodes carry
  // their own). Captured during sync so a sweep can delete files in bulk
  // instead of re-fetching each movie just to learn its file id.
  movieFileId    Int?

  // Aggregated streaming state.
  onStreaming    Boolean   @default(false)
  // True when TMDB returned 404 for this movie's tmdbId — the TMDB entry was
  // deleted/merged, so Radarr is holding a dead id. The sweep can remove these.
  tmdbMissing    Boolean   @default(false)
  // True when the title carries the "ss-skip" tag in Sonarr/Radarr. Skipped
  // titles are never looked up, never re-monitored/unmonitored, never have
  // files deleted and are excluded from the end-of-run search.
  skipped        Boolean   @default(false)
  // True when the Watchmode lookup failed (transient error / unmapped title).
  // The sweep must NOT re-monitor items whose streaming status is unknown, to
  // avoid churn from a temporary Watchmode outage.
  streamingUnknown Boolean @default(false)
  // JSON blob of matched sources: [{sourceId,name,logo,type,region,webUrl}]
  // `webUrl` is Watchmode's `web_url` deep link to this title on that service,
  // and is what the dashboard provider logos link to.
  streamingInfo  Json?

  // Episode roll-ups for TV (movies leave these at 0).
  totalEpisodes      Int   @default(0)
  monitoredEpisodes  Int   @default(0)
  streamingEpisodes  Int   @default(0)

  lastSyncedAt   DateTime  @default(now())
  // Last time this item's streaming availability was pulled from the provider
  // (Watchmode for TV). Used to skip the provider call when data is fresh and
  // the changes-feed says the title hasn't changed. Null = never pulled.
  providerSyncedAt DateTime?
  // Last time we asked Watchmode's title-level sources endpoint for per-provider
  // deep links (`web_url`). Tracked separately from providerSyncedAt because the
  // per-episode availability pull does not return usable links on free plans, so
  // the two calls are made on independent schedules. Null = never asked.
  providerLinksSyncedAt DateTime?

  connection     ArrConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId   Int

  episodes       Episode[]

  @@unique([connectionId, type, arrId])
  // The dashboard always filters on both columns together; two single-column
  // indexes make Postgres pick one and filter the rest by hand.
  @@index([type, onStreaming])
  // Sync prunes rows it did not touch this pass by timestamp.
  @@index([connectionId, type, lastSyncedAt])
}

// Cached episode snapshot for TV media.
model Episode {
  id            Int      @id @default(autoincrement())
  arrEpisodeId  Int
  seasonNumber  Int
  episodeNumber Int
  title         String?
  // When the episode aired (UTC), as Sonarr reports it. Null for an episode
  // with no announced date. The sweep needs this to tell "this season is done
  // with and every episode of it is on streaming" apart from "this season is
  // still airing" — see planSeasons() in lib/sweep.ts.
  airDateUtc    DateTime?
  monitored     Boolean  @default(false)
  hasFile       Boolean  @default(false)
  episodeFileId Int?
  onStreaming   Boolean  @default(false)
  streamingUnknown Boolean @default(false)
  streamingInfo Json?

  media         MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId       Int

  @@unique([mediaId, arrEpisodeId])
  // The end-of-run search collects every monitored episode across the library.
  @@index([mediaId, monitored])
}

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum RunKind {
  SWEEP
  SYNC
}

// Audit log of each sync/sweep run. Also acts as the concurrency lock: a run
// with status RUNNING (and a recent heartbeat) blocks new runs.
model RunLog {
  id                 Int       @id @default(autoincrement())
  kind               RunKind   @default(SWEEP)
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  // Updated periodically while running so a crashed run can be detected as
  // stale and no longer holds the lock.
  heartbeatAt        DateTime  @default(now())
  status             RunStatus @default(RUNNING)
  dryRun             Boolean   @default(true)

  unmonitoredMovies  Int       @default(0)
  remonitoredMovies  Int       @default(0)
  unmonitoredEps     Int       @default(0)
  remonitoredEps     Int       @default(0)
  deletedFiles       Int       @default(0)
  removedMovies      Int       @default(0)
  searchedItems      Int       @default(0)

  // Human-readable step log.
  log                Json?
  error              String?

  @@index([status, heartbeatAt])
}
